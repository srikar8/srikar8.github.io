---
import HeaderLink from './HeaderLink.astro';
import { profile } from '../data/resume';
---

<header>
	<nav>
		<a class="brand" href="/" aria-label="Home">
			<svg class="brand-core" viewBox="0 0 64 64" aria-hidden="true">
				<circle cx="32" cy="32" r="20" fill="none" stroke="currentColor" stroke-width="5"></circle>
				<circle cx="32" cy="32" r="9" class="brand-eye"></circle>
			</svg>
			<span class="brand-text">
				<span class="brand-name">Srikar</span>
				<span class="brand-tag mono"><span class="t-theme">LAB · UNIT SM-26</span><span class="t-plain">AI Engineer</span></span>
			</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog"><span class="t-theme">Field Logs</span><span class="t-plain">Blog</span></HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href={profile.resume} target="_blank">Resume</HeaderLink>
		</div>
		<div class="actions">
			<button class="view-toggle mono" type="button" data-view-toggle aria-pressed="false">
				<span class="t-theme">Plain view</span><span class="t-plain">Lab view</span>
			</button>
			<a class="social" href={profile.github} target="_blank" rel="noopener">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a class="social" href={profile.linkedin} target="_blank" rel="noopener">
				<span class="sr-only">LinkedIn</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
					<path
						fill="currentColor"
						d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
					></path>
				</svg>
			</a>
			<a class="btn btn-primary hire" href={`mailto:${profile.email}`}>
				<span class="t-theme">Activate</span><span class="t-plain">Hire me</span>
			</a>
		</div>
	</nav>
</header>

<script>
	const toggles = document.querySelectorAll<HTMLButtonElement>('[data-view-toggle]');
	const root = document.documentElement;
	const sync = () =>
		toggles.forEach((t) => t.setAttribute('aria-pressed', String(root.classList.contains('plain'))));
	sync();
	toggles.forEach((t) =>
		t.addEventListener('click', () => {
			const plain = root.classList.toggle('plain');
			try {
				localStorage.setItem('view', plain ? 'plain' : 'lab');
			} catch (e) {}
			sync();
		})
	);
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		padding: 0 1rem;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--line);
	}
	nav {
		width: min(1120px, 100%);
		margin: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--orange);
	}
	.brand-core {
		width: 34px;
		height: 34px;
	}
	.brand-eye {
		fill: var(--cyan);
		animation: blink 4s infinite;
	}
	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1.1;
	}
	.brand-name {
		color: var(--heading);
		font-weight: 700;
	}
	.brand-tag {
		font-size: 0.65rem;
		letter-spacing: 0.14em;
		color: var(--muted);
	}
	.internal-links {
		display: flex;
		gap: 0.25rem;
	}
	.internal-links :global(a) {
		padding: 0.4em 0.75em;
		border-radius: 999px;
		color: var(--text);
		font-size: 0.92rem;
	}
	.internal-links :global(a:hover) {
		color: var(--heading);
		background: rgba(63, 242, 255, 0.08);
	}
	.internal-links :global(a.active) {
		color: var(--heading);
		text-decoration: none;
		background: rgba(255, 122, 26, 0.14);
		box-shadow: inset 0 0 0 1px rgba(255, 122, 26, 0.5);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.social {
		display: flex;
		color: var(--muted);
	}
	.social:hover {
		color: var(--heading);
	}
	.view-toggle {
		font-size: 0.72rem;
		padding: 0.45em 0.8em;
		border-radius: 999px;
		border: 1px dashed var(--line-strong);
		background: transparent;
		color: var(--muted);
		cursor: pointer;
	}
	.view-toggle:hover {
		color: var(--heading);
	}
	.hire {
		padding: 0.5em 1em;
	}
	@keyframes blink {
		0%,
		92%,
		100% {
			opacity: 1;
		}
		95% {
			opacity: 0.15;
		}
	}
	@media (max-width: 860px) {
		.social,
		.brand-tag {
			display: none;
		}
	}
	@media (max-width: 640px) {
		nav {
			flex-wrap: wrap;
			padding: 0.5rem 0;
		}
		.internal-links {
			order: 3;
			width: 100%;
			justify-content: space-between;
		}
	}
</style>
