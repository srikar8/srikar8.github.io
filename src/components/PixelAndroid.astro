---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const sprite = [
	'....KKKKKKKK....',
	'...KHHHHHHHHK...',
	'..KHHHHHHHHHhK..',
	'..KHVVVVVVVVhK..',
	'..KHVYvVVYvVhK..',
	'..KHVVVVVVVVhK..',
	'..KHHHHHHHHHhK..',
	'...KhhhKKhhhK...',
	'....KKBBBBKK....',
	'..KKOOBBBBOOKK..',
	'.KBBOOOBBOOOBBK.',
	'KHBBBBKCCKBBBBHK',
	'KHBBBBKCCKBBBBHK',
	'KHKBBBBKKBBBBKHK',
	'KhKBBBBBBBBBBKhK',
	'KK.KbbbbbbbbK.KK',
	'...KBBBKKBBBK...',
	'...KBBK..KBBK...',
	'...KBBK..KBBK...',
	'...KhhK..KhhK...',
	'..KHHHK..KHHHK..',
	'..KKKKK..KKKKK..',
];

const colors: Record<string, string> = {
	K: '#0a0f1c',
	H: '#c9d3e6',
	h: '#8b97ad',
	V: '#3ff2ff',
	v: '#129bb0',
	Y: '#ffffff',
	O: '#ff7a1a',
	C: '#ffd23f',
	B: '#22324f',
	b: '#16213a',
};

const paths: Record<string, string[]> = {};
sprite.forEach((row, y) =>
	[...row].forEach((c, x) => {
		if (c === '.') return;
		(paths[c] ||= []).push(`M${x} ${y}h1v1h-1z`);
	})
);
---

<svg
	viewBox="0 0 16 22"
	class:list={['px-android', className]}
	shape-rendering="crispEdges"
	aria-hidden="true"
>
	{Object.entries(paths).map(([c, d]) => <path d={d.join('')} fill={colors[c]} class={`px-${c.toLowerCase()}${c === c.toUpperCase() ? '' : '-shade'}`} />)}
</svg>

<style>
	.px-android {
		display: block;
		overflow: visible;
	}
	.px-y {
		animation: px-blink 4.2s infinite;
	}
	.px-c {
		animation: px-core 1.6s ease-in-out infinite;
	}
	@keyframes px-blink {
		0%,
		90%,
		100% {
			opacity: 1;
		}
		93% {
			opacity: 0;
		}
	}
	@keyframes px-core {
		50% {
			fill: #fff6c2;
		}
	}
</style>
