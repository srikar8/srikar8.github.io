---
import PixelAndroid from './PixelAndroid.astro';
import type { Upgrade } from '../data/resume';

interface Props {
	upgrades: Upgrade[];
}

const pods = [...Astro.props.upgrades].reverse();
---

<div class="lab panel">
	<div class="lab-bar mono">
		<span class="lights deco" aria-hidden="true"><i></i><i></i><i></i></span>
		<span class="t-theme">GERO LAB · SUNNYVALE</span><span class="t-plain">Career stops</span>
	</div>

	<div class="stage">
		<div class="unit-wrap deco">
			<div class="unit-glow" aria-hidden="true"></div>
			<PixelAndroid class="hero-unit" />
			<span class="platform" aria-hidden="true"></span>
			<span class="unit-tag mono">MODEL 26 · ONLINE</span>
		</div>

		<div class="rack" aria-labelledby="rack-title">
			<div class="rack-head mono">
				<span id="rack-title"><span class="t-theme">ANDROID PODS</span><span class="t-plain">CAREER STOPS</span></span>
				<span class="rack-count">0{pods.length}</span>
			</div>
			<ol class="pods">
				{
					pods.map((u, i) => (
						<li>
							<button
								class:list={['pod', { current: i === pods.length - 1 }]}
								style={`--n:${i}`}
								data-model={u.model}
								title={`Model ${u.model} · ${u.org} · ${u.period}`}
								aria-label={`${u.org}, ${u.period}. Show in the upgrade history`}
							>
								<span class="pod-cap" aria-hidden="true" />
								<span class="pod-glass" aria-hidden="true">
									<PixelAndroid class="pod-unit" />
									<span class="bubble b1" />
									<span class="bubble b2" />
								</span>
								<span class="pod-label mono">{u.model}</span>
							</button>
						</li>
					))
				}
				<li>
					<span class="pod pod-empty" title="The next model is still in development" aria-hidden="true">
						<span class="pod-cap" />
						<span class="pod-glass">?</span>
						<span class="pod-label mono">--</span>
					</span>
				</li>
			</ol>
		</div>
	</div>

	<a class="talk" href="#paths">
		<span class="speaker mono">UNIT 16</span>
		<span class="talk-text" data-typed>Visitor detected. Career or projects? Pick a capsule below.</span>
		<span class="talk-arrow deco" aria-hidden="true">▼</span>
	</a>
</div>

<script>
	const typed = document.querySelector<HTMLElement>('[data-typed]');
	const root = document.documentElement;
	const still =
		window.matchMedia('(prefers-reduced-motion: reduce)').matches || root.classList.contains('plain');
	if (typed && !still) {
		const full = typed.textContent ?? '';
		typed.textContent = '';
		typed.setAttribute('aria-label', full);
		let i = 0;
		const step = () => {
			typed.textContent = full.slice(0, ++i);
			if (i < full.length) setTimeout(step, full[i - 1] === '.' || full[i - 1] === '?' ? 260 : 28);
		};
		setTimeout(step, 700);
	}

	document.querySelectorAll<HTMLButtonElement>('.pod[data-model]').forEach((pod) =>
		pod.addEventListener('click', () => {
			const target = document.getElementById(`model-${pod.dataset.model}`);
			if (!target) return;
			target.querySelector('details')?.setAttribute('open', '');
			target.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' });
			target.classList.remove('flash');
			void target.offsetWidth;
			target.classList.add('flash');
		})
	);
</script>

<style>
	.lab {
		overflow: hidden;
		box-shadow:
			0 30px 80px rgba(0, 0, 0, 0.5),
			var(--glow-cyan);
	}
	.lab-bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.6rem 1rem;
		font-size: 0.7rem;
		letter-spacing: 0.14em;
		color: var(--muted);
		border-bottom: 1px solid var(--line);
		background: rgba(63, 242, 255, 0.04);
	}
	.lights {
		display: flex;
		gap: 6px;
	}
	.lights i {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: var(--red);
	}
	.lights i:nth-child(2) {
		background: var(--yellow);
	}
	.lights i:nth-child(3) {
		background: var(--green);
	}

	.stage {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1.15fr;
		gap: 1rem;
		align-items: end;
		padding: 1.4rem 1.2rem 1rem;
		background:
			linear-gradient(transparent 62%, rgba(63, 242, 255, 0.08) 62%, transparent 100%),
			repeating-linear-gradient(90deg, rgba(63, 242, 255, 0.07) 0 1px, transparent 1px 28px);
	}
	:global(html.plain) .stage {
		grid-template-columns: 1fr;
		background: none;
	}

	.unit-wrap {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		padding-top: 1rem;
	}
	.unit-glow {
		position: absolute;
		bottom: 18px;
		width: 160px;
		height: 160px;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(255, 122, 26, 0.35), transparent 65%);
		animation: glow 2.4s ease-in-out infinite;
	}
	.unit-wrap :global(.hero-unit) {
		position: relative;
		width: 120px;
		height: 165px;
		filter: drop-shadow(0 6px 0 rgba(0, 0, 0, 0.4));
		animation: hover 2.4s ease-in-out infinite;
	}
	.platform {
		width: 150px;
		height: 22px;
		margin-top: 4px;
		border-radius: 50%;
		background: radial-gradient(ellipse, rgba(63, 242, 255, 0.55), rgba(63, 242, 255, 0.08) 60%, transparent 72%);
		box-shadow: 0 0 0 2px rgba(63, 242, 255, 0.35);
		animation: platform 2.4s ease-in-out infinite;
	}
	.unit-tag {
		margin-top: 0.6rem;
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		color: var(--green);
	}

	.rack {
		border: 1px solid var(--line-strong);
		border-radius: 12px;
		background: rgba(5, 9, 18, 0.7);
		padding: 0.6rem 0.7rem 0.8rem;
	}
	:global(html.plain) .rack {
		background: var(--panel);
	}
	.rack-head {
		display: flex;
		justify-content: space-between;
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		color: var(--muted);
		padding-bottom: 0.5rem;
		margin-bottom: 0.6rem;
		border-bottom: 1px dashed var(--line);
	}
	.rack-count {
		color: var(--orange);
	}
	.pods {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.6rem 0.5rem;
	}
	.pod {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		width: 100%;
		padding: 0;
		background: none;
		border: 0;
		cursor: pointer;
		color: inherit;
		animation: pod-in 0.5s cubic-bezier(0.3, 1.5, 0.6, 1) both;
		animation-delay: calc(0.4s + var(--n, 0) * 0.08s);
	}
	.pod-cap {
		width: 70%;
		height: 6px;
		border-radius: 4px 4px 0 0;
		background: linear-gradient(#6b7891, #2c3549);
	}
	.pod-glass {
		position: relative;
		display: grid;
		place-items: center;
		width: 100%;
		height: 62px;
		overflow: hidden;
		border-radius: 10px;
		border: 1px solid rgba(63, 242, 255, 0.4);
		background: linear-gradient(180deg, rgba(63, 242, 255, 0.08), rgba(63, 242, 255, 0.28));
		transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
	}
	.pod-glass::after {
		content: '';
		position: absolute;
		inset: 4px auto 4px 5px;
		width: 3px;
		border-radius: 2px;
		background: rgba(255, 255, 255, 0.35);
	}
	.pod :global(.pod-unit) {
		width: 26px;
		height: 36px;
		opacity: 0.55;
		filter: brightness(0.6) saturate(0.6);
		transition: opacity 0.2s, filter 0.2s;
	}
	.bubble {
		position: absolute;
		bottom: 4px;
		width: 4px;
		height: 4px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.6);
		animation: bubble 3s linear infinite;
	}
	.b1 {
		left: 30%;
		animation-delay: calc(var(--n, 0) * -0.4s);
	}
	.b2 {
		left: 68%;
		animation-delay: calc(var(--n, 0) * -0.7s - 1.3s);
	}
	.pod-label {
		margin-top: 3px;
		padding: 0 0.4em;
		font-size: 0.66rem;
		font-weight: 700;
		color: var(--muted);
		border-radius: 3px;
		background: rgba(255, 255, 255, 0.04);
	}
	.pod:hover .pod-glass,
	.pod:focus-visible .pod-glass {
		transform: translateY(-3px);
		border-color: var(--cyan);
		box-shadow: var(--glow-cyan);
	}
	.pod:hover :global(.pod-unit),
	.pod:focus-visible :global(.pod-unit) {
		opacity: 1;
		filter: none;
	}
	.pod:hover .pod-label {
		color: var(--heading);
	}
	.pod.current .pod-glass {
		border-color: var(--green);
		background: linear-gradient(180deg, rgba(95, 208, 104, 0.1), rgba(95, 208, 104, 0.32));
		box-shadow: 0 0 16px rgba(95, 208, 104, 0.35);
	}
	.pod.current :global(.pod-unit) {
		opacity: 1;
		filter: none;
	}
	.pod.current .pod-label {
		color: #08140a;
		background: var(--green);
	}
	.pod-empty {
		cursor: default;
	}
	.pod-empty .pod-glass {
		border-style: dashed;
		background: transparent;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 1.2rem;
	}
	.pod-empty .pod-glass::after {
		display: none;
	}

	.talk {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		margin: 0 1rem 1rem;
		padding: 0.85rem 1rem;
		min-height: 3.6rem;
		border-radius: 8px;
		border: 2px solid var(--heading);
		box-shadow:
			inset 0 0 0 3px var(--panel-solid),
			inset 0 0 0 4px var(--line-strong);
		background: var(--panel-solid);
		color: var(--heading);
		text-decoration: none;
		font-size: 0.95rem;
	}
	.talk:hover {
		color: var(--heading);
		border-color: var(--orange);
	}
	.speaker {
		flex: 0 0 auto;
		font-size: 0.62rem;
		letter-spacing: 0.16em;
		padding: 0.2em 0.5em;
		border-radius: 4px;
		background: var(--green);
		color: #08140a;
		font-weight: 700;
	}
	.talk-text {
		flex: 1;
	}
	.talk-arrow {
		color: var(--orange);
		animation: nudge 0.9s ease-in-out infinite;
	}

	@keyframes hover {
		50% {
			transform: translateY(-8px);
		}
	}
	@keyframes glow {
		50% {
			opacity: 0.55;
			transform: scale(0.92);
		}
	}
	@keyframes platform {
		50% {
			transform: scaleX(0.88);
			opacity: 0.75;
		}
	}
	@keyframes bubble {
		0% {
			transform: translateY(0);
			opacity: 0;
		}
		15% {
			opacity: 1;
		}
		100% {
			transform: translateY(-58px);
			opacity: 0;
		}
	}
	@keyframes pod-in {
		from {
			opacity: 0;
			transform: scale(0.5);
		}
	}
	@keyframes nudge {
		50% {
			transform: translateY(3px);
		}
	}

	@media (max-width: 640px) {
		.stage {
			grid-template-columns: 1fr;
		}
		.unit-wrap :global(.hero-unit) {
			width: 96px;
			height: 132px;
		}
	}
</style>
