---
import PixelAndroid from './PixelAndroid.astro';
import type { Android } from '../data/resume';

interface Props {
	androids: Android[];
}

const units = Astro.props.androids.map((a) => ({ id: a.id, name: a.name, origin: a.origin }));
---

<dialog id="capsule-reveal" aria-labelledby="reveal-title">
	<div class="reveal-stage">
		<button class="skip mono" type="button" data-skip>Skip ↗</button>
		<p class="eyebrow" id="reveal-title">Opening capsule</p>
		<div class="r-scene" aria-hidden="true">
			<span class="r-flash"></span>
			<span class="r-smoke">
				<i style="--x:-70px;--y:-30px;--s:1.1"></i>
				<i style="--x:60px;--y:-40px;--s:1"></i>
				<i style="--x:-40px;--y:40px;--s:0.9"></i>
				<i style="--x:70px;--y:30px;--s:1.2"></i>
				<i style="--x:0px;--y:-70px;--s:1"></i>
				<i style="--x:0px;--y:55px;--s:0.8"></i>
			</span>
			<span class="r-capsule">
				<span class="r-l"></span>
				<span class="r-r"></span>
				<span class="r-btn"></span>
			</span>
			<span class="r-partner">
				<PixelAndroid class="r-unit" />
			</span>
		</div>
		<p class="r-msg" aria-live="polite">
			<strong data-msg>Model 26 online.</strong>
			<small class="mono" data-sub>Loading upgrade history…</small>
		</p>
	</div>
</dialog>

<script define:vars={{ units }}>
	const dialog = document.getElementById('capsule-reveal');
	const title = document.getElementById('reveal-title');
	const msg = dialog.querySelector('[data-msg]');
	const sub = dialog.querySelector('[data-sub]');
	const partner = dialog.querySelector('.r-partner');
	const hues = [0, 150, 35, 270, 195, 95];
	let timer;
	let pending;

	const still = () =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
		document.documentElement.classList.contains('plain');

	function land({ target, highlight }) {
		const section = document.querySelector(target);
		section?.scrollIntoView({ behavior: still() ? 'auto' : 'smooth', block: 'start' });
		if (highlight) {
			const el = document.getElementById(highlight);
			el?.classList.remove('flash');
			void el?.offsetWidth;
			el?.classList.add('flash');
		}
	}

	function finish() {
		clearTimeout(timer);
		if (dialog.open) dialog.close();
		document.body.classList.remove('modal-open');
		if (pending) land(pending);
		pending = null;
	}

	function open(pack) {
		let config;
		if (pack === 'projects') {
			const i = Math.floor(Math.random() * units.length);
			const u = units[i];
			config = {
				target: '#androids',
				highlight: `android-${u.id}`,
				title: 'Opening capsule · Android lineup',
				msg: `Android #${u.id} activated.`,
				sub: `${u.name} · ${u.origin}`,
				hue: hues[i % hues.length],
				kind: 'b',
			};
		} else {
			config = {
				target: '#upgrades',
				highlight: 'model-26',
				title: 'Opening capsule · Model upgrades',
				msg: 'Model 26 online.',
				sub: 'Loading upgrade history…',
				hue: 0,
				kind: 'a',
			};
		}
		pending = config;
		if (still() || typeof dialog.showModal !== 'function') return finish();

		title.textContent = config.title;
		msg.textContent = config.msg;
		sub.textContent = config.sub;
		partner.style.setProperty('--hue', `${config.hue}deg`);
		dialog.dataset.kind = config.kind;
		dialog.classList.remove('playing');
		dialog.showModal();
		document.body.classList.add('modal-open');
		void dialog.offsetWidth;
		dialog.classList.add('playing');
		timer = setTimeout(finish, 3300);
	}

	document.querySelectorAll('[data-pack]').forEach((el) =>
		el.addEventListener('click', (e) => {
			e.preventDefault();
			open(el.dataset.pack);
		})
	);
	dialog.querySelector('[data-skip]').addEventListener('click', finish);
	dialog.addEventListener('cancel', (e) => {
		e.preventDefault();
		finish();
	});
</script>

<style>
	dialog {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--text);
	}
	dialog::backdrop {
		background:
			radial-gradient(circle at 50% 45%, rgba(255, 122, 26, 0.18), transparent 45%),
			rgba(3, 6, 14, 0.92);
		backdrop-filter: blur(4px);
	}
	:global(body.modal-open) {
		overflow: hidden;
	}
	.reveal-stage {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 1rem;
		text-align: center;
	}
	.skip {
		position: absolute;
		top: 1.2rem;
		right: 1.2rem;
		padding: 0.5em 1em;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
		background: transparent;
		color: var(--text);
		font-size: 0.8rem;
		cursor: pointer;
	}
	.skip:hover {
		color: var(--heading);
		border-color: var(--orange);
	}
	.r-scene {
		position: relative;
		width: 260px;
		height: 260px;
		display: grid;
		place-items: center;
	}
	.r-scene > * {
		position: absolute;
	}

	.r-capsule {
		width: 150px;
		height: 58px;
		opacity: 0;
	}
	.r-l,
	.r-r {
		position: absolute;
		top: 0;
		width: 50%;
		height: 100%;
	}
	.r-l {
		left: 0;
		border-radius: 29px 0 0 29px;
		background: linear-gradient(180deg, #ffa25c, var(--orange) 55%, #c4520a);
		border-right: 4px solid #1a1a1a;
	}
	dialog[data-kind='b'] .r-l {
		background: linear-gradient(180deg, #8ff8ff, #22c8d8 55%, #11808c);
	}
	.r-r {
		right: 0;
		border-radius: 0 29px 29px 0;
		background: linear-gradient(180deg, #ffffff, #d9dee8 55%, #9aa3b5);
	}
	.r-btn {
		position: absolute;
		left: 50%;
		top: 50%;
		width: 20px;
		height: 20px;
		margin: -10px 0 0 -10px;
		border-radius: 50%;
		background: #1a1a1a;
		box-shadow: inset 0 0 0 5px #e6e9f0;
		z-index: 1;
	}

	.r-flash {
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: radial-gradient(circle, #fff, rgba(255, 210, 63, 0.8) 35%, rgba(255, 122, 26, 0) 70%);
		opacity: 0;
	}
	.r-smoke i {
		position: absolute;
		left: -40px;
		top: -40px;
		width: 80px;
		height: 80px;
		border-radius: 50%;
		background: radial-gradient(circle at 40% 35%, #f4f6fb, #b9c2d3 60%, rgba(185, 194, 211, 0) 72%);
		opacity: 0;
	}
	.r-partner {
		opacity: 0;
		filter: hue-rotate(var(--hue, 0deg));
	}
	.r-partner :global(.r-unit) {
		width: 128px;
		height: 176px;
	}
	.r-msg {
		min-height: 3.5rem;
		margin: 0;
		opacity: 0;
	}
	.r-msg strong {
		display: block;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: 2.2rem;
		letter-spacing: 0.03em;
		color: var(--heading);
	}
	.r-msg small {
		color: var(--cyan);
		letter-spacing: 0.1em;
		font-size: 0.75rem;
	}

	.playing .r-capsule {
		animation:
			arrive 0.45s cubic-bezier(0.2, 1.4, 0.5, 1) forwards,
			shake 0.6s 0.5s ease-in-out;
	}
	.playing .r-btn {
		animation:
			btn-flash 0.15s 1s forwards,
			fade-out 0.15s 1.2s forwards;
	}
	.playing .r-l {
		animation: split-l 0.5s 1.2s cubic-bezier(0.3, 0.8, 0.4, 1) forwards;
	}
	.playing .r-r {
		animation: split-r 0.5s 1.2s cubic-bezier(0.3, 0.8, 0.4, 1) forwards;
	}
	.playing .r-flash {
		animation: flash 0.75s 1.2s ease-out forwards;
	}
	.playing .r-smoke i {
		animation: puff 1.1s 1.2s ease-out forwards;
	}
	.playing .r-partner {
		animation: release 0.8s 1.4s ease-out forwards;
	}
	.playing .r-msg {
		animation: msg-in 0.4s 1.9s ease-out forwards;
	}

	@keyframes arrive {
		from {
			opacity: 0;
			transform: translateY(160px) scale(0.5);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes shake {
		20% {
			transform: rotate(-12deg);
		}
		40% {
			transform: rotate(10deg);
		}
		60% {
			transform: rotate(-7deg);
		}
		80% {
			transform: rotate(5deg);
		}
	}
	@keyframes btn-flash {
		to {
			background: var(--yellow);
			box-shadow:
				0 0 24px var(--yellow),
				inset 0 0 0 5px #fff7b0;
		}
	}
	@keyframes fade-out {
		to {
			opacity: 0;
		}
	}
	@keyframes split-l {
		to {
			transform: translate(-120px, 30px) rotate(-35deg);
			opacity: 0;
		}
	}
	@keyframes split-r {
		to {
			transform: translate(120px, 30px) rotate(35deg);
			opacity: 0;
		}
	}
	@keyframes flash {
		0% {
			opacity: 0;
			transform: scale(0.3);
		}
		35% {
			opacity: 1;
			transform: scale(3.5);
		}
		100% {
			opacity: 0;
			transform: scale(6);
		}
	}
	@keyframes puff {
		0% {
			opacity: 0;
			transform: translate(0, 0) scale(0.2);
		}
		30% {
			opacity: 0.95;
		}
		100% {
			opacity: 0;
			transform: translate(var(--x), var(--y)) scale(calc(var(--s) * 1.8));
		}
	}
	@keyframes release {
		0% {
			opacity: 0;
			transform: scale(0.1);
			filter: hue-rotate(var(--hue, 0deg)) brightness(0) invert(1);
		}
		55% {
			opacity: 1;
			transform: scale(1.1);
			filter: hue-rotate(var(--hue, 0deg)) brightness(0) invert(1) drop-shadow(0 0 12px #fff);
		}
		100% {
			opacity: 1;
			transform: none;
			filter: hue-rotate(var(--hue, 0deg)) drop-shadow(0 6px 0 rgba(0, 0, 0, 0.4));
		}
	}
	@keyframes msg-in {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
