---
import { upgrades } from '../data/resume';

/** Chronological base → Ultra Instinct for the journey power-up. */
const journeyForms = [...upgrades].reverse().map((u) => u.form);
const finalForm = journeyForms[journeyForms.length - 1];
---

<dialog id="saiyan-transform" aria-labelledby="transform-title">
	<div class="t-stage">
		<button class="skip mono" type="button" data-skip>Skip ↗</button>
		<p class="eyebrow" id="transform-title">Powering up</p>

		<div class="arena" aria-hidden="true">
			<span class="flash"></span>
			<span class="aura">
				<i></i><i></i><i></i>
			</span>
			<span class="streaks">
				<i style="--x:-62px;--d:0s"></i>
				<i style="--x:-30px;--d:0.25s"></i>
				<i style="--x:8px;--d:0.1s"></i>
				<i style="--x:40px;--d:0.35s"></i>
				<i style="--x:66px;--d:0.18s"></i>
			</span>
			<span class="fighter">
				{
					journeyForms.map((f, i) => (
						<img
							class:list={['form', { active: i === 0 }]}
							src={f.img}
							alt=""
							width="160"
							height="240"
							data-form={f.key}
							data-name={f.name}
							data-aura={f.aura}
							decoding="async"
						/>
					))
				}
			</span>
			<span class="ground"></span>
			<span class="rocks">
				<i style="--x:-90px;--r:-40deg;--s:9px;--d:0.2s"></i>
				<i style="--x:-55px;--r:25deg;--s:6px;--d:0.5s"></i>
				<i style="--x:60px;--r:-15deg;--s:8px;--d:0.35s"></i>
				<i style="--x:95px;--r:40deg;--s:5px;--d:0.6s"></i>
				<i style="--x:-110px;--r:10deg;--s:5px;--d:0.75s"></i>
				<i style="--x:115px;--r:-30deg;--s:7px;--d:0.15s"></i>
			</span>
		</div>

		<p class="power mono"><span class="power-k">POWER LEVEL</span> <span data-power>0005</span></p>
		<p class="t-msg" aria-live="polite">
			<strong data-form-name>{finalForm.name}</strong>
			<small class="mono" data-sub>Opening experience</small>
		</p>
	</div>
</dialog>

<script>
	const dialog = document.getElementById('saiyan-transform') as HTMLDialogElement;
	const power = dialog.querySelector<HTMLElement>('[data-power]')!;
	const sub = dialog.querySelector<HTMLElement>('[data-sub]')!;
	const formName = dialog.querySelector<HTMLElement>('[data-form-name]')!;
	const forms = [...dialog.querySelectorAll<HTMLImageElement>('.form')];
	const DURATION = 4200;
	const SURGE = 2800;
	let timer: number | undefined;
	let raf = 0;
	let formTimer: number | undefined;
	let target: string | null = null;

	const still = () =>
		window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
		document.documentElement.classList.contains('plain');

	function setForm(i: number) {
		forms.forEach((el, n) => el.classList.toggle('active', n === i));
		const f = forms[i];
		if (!f) return;
		formName.textContent = f.dataset.name ?? '';
		dialog.style.setProperty('--aura', f.dataset.aura ?? '#ffd23f');
	}

	function finish() {
		clearTimeout(timer);
		clearInterval(formTimer);
		cancelAnimationFrame(raf);
		if (dialog.open) dialog.close();
		document.body.classList.remove('modal-open');
		if (target) document.querySelector(target)?.scrollIntoView({ behavior: still() ? 'auto' : 'smooth' });
		target = null;
	}

	function countUp() {
		const start = performance.now();
		const tick = (t: number) => {
			const p = Math.min((t - start) / SURGE, 1);
			if (p < 1) {
				power.textContent = String(Math.floor(5 + Math.pow(p, 3) * 8990)).padStart(4, '0');
				raf = requestAnimationFrame(tick);
			} else {
				power.textContent = "IT'S OVER 9000!";
			}
		};
		raf = requestAnimationFrame(tick);
	}

	function cycleForms(journey: boolean) {
		if (journey) {
			let i = 0;
			setForm(0);
			formTimer = window.setInterval(() => {
				i = Math.min(i + 1, forms.length - 1);
				setForm(i);
				if (i >= forms.length - 1) clearInterval(formTimer);
			}, Math.floor(SURGE / Math.max(forms.length - 1, 1)));
		} else {
			setForm(forms.length - 1);
		}
	}

	function open(pack: string, href: string) {
		target = href;
		if (still() || typeof dialog.showModal !== 'function') return finish();
		const journey = pack === 'journey';
		dialog.dataset.kind = journey ? 'journey' : 'projects';
		sub.textContent = journey ? 'Opening experience' : 'Opening projects';
		power.textContent = '0005';
		dialog.classList.remove('playing');
		dialog.showModal();
		document.body.classList.add('modal-open');
		void dialog.offsetWidth;
		dialog.classList.add('playing');
		cycleForms(journey);
		countUp();
		timer = window.setTimeout(finish, DURATION);
	}

	document.querySelectorAll<HTMLAnchorElement>('[data-pack]').forEach((el) =>
		el.addEventListener('click', (e) => {
			e.preventDefault();
			open(el.dataset.pack ?? 'journey', el.getAttribute('href') ?? '#upgrades');
		})
	);
	dialog.querySelector('[data-skip]')!.addEventListener('click', finish);
	dialog.addEventListener('cancel', (e) => {
		e.preventDefault();
		finish();
	});
</script>

<style>
	dialog {
		width: 100vw;
		height: 100vh;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: var(--text);
		overflow: hidden;
		--aura: #ffd23f;
	}
	dialog::backdrop {
		background: rgba(3, 5, 12, 0.94);
		backdrop-filter: blur(4px);
	}
	:global(body.modal-open) {
		overflow: hidden;
	}
	.t-stage {
		position: relative;
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.6rem;
		text-align: center;
	}
	.skip {
		position: absolute;
		top: 1.2rem;
		right: 1.2rem;
		padding: 0.5em 1em;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
		background: transparent;
		color: var(--text);
		font-size: 0.8rem;
		cursor: pointer;
		z-index: 2;
	}
	.skip:hover {
		color: var(--heading);
		border-color: var(--orange);
	}

	.arena {
		position: relative;
		width: 320px;
		height: 340px;
	}
	.arena > * {
		position: absolute;
		left: 50%;
	}
	.fighter {
		bottom: 28px;
		width: 180px;
		height: 260px;
		margin-left: -90px;
		z-index: 2;
	}
	.form {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: bottom center;
		opacity: 0;
		filter: drop-shadow(0 8px 0 rgba(0, 0, 0, 0.45));
		transition: opacity 0.18s ease;
		pointer-events: none;
	}
	.form.active {
		opacity: 1;
	}

	.ground {
		bottom: 18px;
		width: 240px;
		height: 28px;
		margin-left: -120px;
		border-radius: 50%;
		background: radial-gradient(ellipse, color-mix(in srgb, var(--aura) 45%, transparent), transparent 70%);
		opacity: 0;
	}

	.aura {
		bottom: 16px;
		width: 230px;
		height: 290px;
		margin-left: -115px;
		opacity: 0;
		z-index: 1;
	}
	.aura i {
		position: absolute;
		inset: 0;
		border-radius: 50% 50% 46% 46% / 64% 64% 36% 36%;
		background: radial-gradient(
			ellipse at 50% 70%,
			rgba(255, 255, 255, 0.9),
			color-mix(in srgb, var(--aura) 75%, transparent) 30%,
			color-mix(in srgb, var(--aura) 35%, transparent) 55%,
			transparent 70%
		);
		filter: blur(2px);
		transform-origin: 50% 100%;
	}
	.aura i:nth-child(2) {
		inset: 10% 16% 0;
		clip-path: polygon(
			50% 0,
			62% 22%,
			80% 8%,
			76% 36%,
			100% 30%,
			86% 60%,
			100% 100%,
			0 100%,
			14% 60%,
			0 30%,
			24% 36%,
			20% 8%,
			38% 22%
		);
		background: linear-gradient(
			to top,
			rgba(255, 255, 255, 0.95),
			color-mix(in srgb, var(--aura) 90%, #fff) 45%,
			color-mix(in srgb, var(--aura) 0%, transparent)
		);
		filter: none;
	}
	.aura i:nth-child(3) {
		inset: -8% -10% 0;
		opacity: 0.5;
	}

	.streaks,
	.rocks {
		bottom: 0;
		z-index: 3;
	}
	.streaks i {
		position: absolute;
		bottom: 30px;
		left: var(--x);
		width: 3px;
		height: 60px;
		border-radius: 2px;
		background: linear-gradient(to top, transparent, #fff8c9, transparent);
		opacity: 0;
	}
	.rocks i {
		position: absolute;
		bottom: 26px;
		left: var(--x);
		width: var(--s);
		height: var(--s);
		background: #6b6f7d;
		box-shadow: inset -2px -2px 0 #3d404b;
		opacity: 0;
	}
	.flash {
		top: 40%;
		width: 40px;
		height: 40px;
		margin-left: -20px;
		border-radius: 50%;
		background: #fff;
		opacity: 0;
		z-index: 3;
	}

	.power {
		margin: 0;
		font-size: 0.95rem;
		letter-spacing: 0.12em;
		color: var(--heading);
	}
	.power-k {
		color: var(--muted);
		margin-right: 0.4em;
	}
	[data-power] {
		display: inline-block;
		min-width: 4ch;
		color: var(--yellow);
		font-weight: 700;
	}
	.t-msg {
		margin: 0;
		min-height: 4rem;
		opacity: 0;
	}
	.t-msg strong {
		display: block;
		font-family: var(--font-display);
		font-weight: 400;
		font-size: clamp(2.2rem, 7vw, 3.6rem);
		line-height: 1;
		letter-spacing: 0.04em;
		color: var(--aura, var(--yellow));
		text-shadow:
			3px 3px 0 #1a1020,
			0 0 30px color-mix(in srgb, var(--aura, var(--yellow)) 60%, transparent);
	}
	.t-msg small {
		color: var(--cyan);
		letter-spacing: 0.12em;
		font-size: 0.78rem;
	}

	.playing .arena {
		animation: quake 0.09s linear 0.3s 18, quake-big 0.06s linear 2.7s 8;
	}
	.playing .fighter {
		animation: crouch 2s ease-in 0.3s forwards, rise 0.3s ease-out 2.7s forwards;
	}
	.playing .rocks i {
		animation: lift 2.2s ease-out var(--d) forwards;
	}
	.playing .streaks i {
		animation: streak 0.5s linear calc(2.75s + var(--d)) 4;
	}
	.playing .flash {
		animation: surge 0.6s ease-out 2.65s forwards;
	}
	.playing .aura {
		animation:
			aura-in 0.25s ease-out 2.7s forwards,
			aura-pulse 0.32s ease-in-out 2.95s infinite alternate;
	}
	.playing .aura i:nth-child(2) {
		animation: flicker 0.18s steps(2) 2.7s infinite;
	}
	.playing .ground {
		animation: aura-in 0.25s ease-out 2.7s forwards;
	}
	.playing .t-msg {
		animation: msg-in 0.35s cubic-bezier(0.2, 1.6, 0.5, 1) 2.85s forwards;
	}

	@keyframes quake {
		25% {
			transform: translate(-2px, 1px);
		}
		75% {
			transform: translate(2px, -1px);
		}
	}
	@keyframes quake-big {
		25% {
			transform: translate(-6px, 3px);
		}
		75% {
			transform: translate(6px, -3px);
		}
	}
	@keyframes crouch {
		to {
			transform: translateY(6px) scaleY(0.96);
		}
	}
	@keyframes rise {
		from {
			transform: translateY(6px) scaleY(0.96);
		}
		to {
			transform: translateY(-6px);
		}
	}
	@keyframes lift {
		0% {
			opacity: 0;
			transform: translateY(0) rotate(0);
		}
		20% {
			opacity: 1;
		}
		100% {
			opacity: 0.9;
			transform: translateY(-150px) rotate(var(--r));
		}
	}
	@keyframes streak {
		0% {
			opacity: 0;
			transform: translateY(0);
		}
		30% {
			opacity: 1;
		}
		100% {
			opacity: 0;
			transform: translateY(-200px);
		}
	}
	@keyframes surge {
		0% {
			opacity: 0;
			transform: scale(1);
		}
		15% {
			opacity: 1;
			transform: scale(30);
		}
		100% {
			opacity: 0;
			transform: scale(40);
		}
	}
	@keyframes aura-in {
		from {
			opacity: 0;
			transform: scale(0.4);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
	@keyframes aura-pulse {
		to {
			transform: scale(1.05, 1.08);
		}
	}
	@keyframes flicker {
		50% {
			transform: scaleY(1.08) scaleX(0.95);
		}
	}
	@keyframes msg-in {
		from {
			opacity: 0;
			transform: scale(1.6);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}
</style>
