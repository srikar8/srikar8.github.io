---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHead from '../components/SectionHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import SaiyanTransform from '../components/SaiyanTransform.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';
import {
	profile,
	metrics,
	upgrades,
	androids,
	modules,
	education,
	journey,
	certifications,
} from '../data/resume';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const diagnostics = [
	['UNIT', profile.name],
	['CLASS', 'AI Engineer · Agentic · CV · Multimodal'],
	['CURRENT', `FDSE, Applied AI @ ${profile.currentOrg}`],
	['RUNTIME', `${profile.years} years in production AI`],
	['EFFICIENCY', '−85% manual ops · −50% test time'],
	['COST / LATENCY', '−60% / −40%'],
	['GUARDRAILS', 'ON · HUMAN-IN-THE-LOOP: ON'],
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<!-- HERO -->
			<section class="hero">
				<div class="hero-copy">
					<p class="eyebrow">
						<span class="t-theme">Lab file · Unit SM-26 · {profile.location}</span>
						<span class="t-plain">{profile.title} · {profile.location}</span>
					</p>
					<p class="tagline mono t-theme">Dr. Gero built androids. I build agents.</p>
					<h1 class="display">I make LLMs do <span class="hl">real work</span> in production.</h1>
					<p class="lede">
						Hi, I'm <strong>Srikar</strong>. Right now I build agents that investigate CI failures and automate the
						SDLC for Cisco's NX-OS teams. Before that: an agentic procurement platform, CLIP trained from scratch, and a
						lot of computer vision. {profile.years} years of shipping AI that people actually use.
					</p>
					<div class="cta">
						<a class="btn btn-primary" href={`mailto:${profile.email}`}>
							Email me
						</a>
						<a class="btn" href={profile.resume} target="_blank">Resume (PDF)</a>
					</div>
				</div>

				<div class="scan panel" aria-label="Profile summary">
					<div class="scan-bar mono">
						<span class="lights deco" aria-hidden="true"><i></i><i></i><i></i></span>
						<span class="t-theme">GERO-SUPERCOMPUTER :: DIAGNOSTIC</span><span class="t-plain">Profile</span>
					</div>
					<div class="scan-body">
						<div class="portrait">
							<img src={profile.photo} alt={profile.name} width="160" height="160" />
							<span class="reticle deco" aria-hidden="true"></span>
							<span class="scanline deco" aria-hidden="true"></span>
						</div>
						<ul class="diag mono">
							<li class="cmd deco">&gt; run diagnostic --unit srikar</li>
							{
								diagnostics.map(([k, v], i) => (
									<li style={`--d:${0.35 + i * 0.22}s`}>
										<span class="k">{k}</span>
										<span class="v">{v}</span>
									</li>
								))
							}
							<li class="ready" style={`--d:${0.35 + diagnostics.length * 0.22}s`}>
								<span class="t-theme">STATUS: READY FOR ACTIVATION</span><span class="t-plain">Open to new roles</span>
								<span class="caret deco" aria-hidden="true">▌</span>
							</li>
						</ul>
					</div>
				</div>
			</section>

			<!-- METRICS -->
			<section class="metrics" aria-label="Impact">
				{
					metrics.map((m) => (
						<div class="metric panel reveal">
							<p class="num display">
								<span data-count={m.value}>{m.value}</span>
								{m.suffix}
							</p>
							<p class="label">{m.label}</p>
							<p class="note mono">{m.note}</p>
						</div>
					))
				}
			</section>

			<!-- CHOOSE A PATH -->
			<section class="paths">
				<SectionHead
					index="00"
					eyebrow="Choose a path"
					title="Hop on a cloud."
					plainTitle="Explore"
					guide="Grab the Flying Nimbus — Experience for the route so far, Projects for what shipped."
				/>
				<div class="nimbus-paths">
					<a class="nimbus-card reveal" href="#upgrades" data-pack="journey">
						<span class="nimbus-ride deco" aria-hidden="true">
							<svg class="nimbus-cloud" viewBox="0 0 220 110" role="img">
								<defs>
									<linearGradient id="nimbusGold" x1="0" y1="0" x2="0" y2="1">
										<stop offset="0%" stop-color="#fff1a0" />
										<stop offset="40%" stop-color="#ffd23f" />
										<stop offset="100%" stop-color="#e09a10" />
									</linearGradient>
								</defs>
								<ellipse cx="110" cy="98" rx="72" ry="7" fill="rgba(0,0,0,0.3)" />
								<!-- Flying Nimbus puffs -->
								<g fill="url(#nimbusGold)" stroke="#c4840a" stroke-width="2.5" stroke-linejoin="round">
									<ellipse cx="48" cy="62" rx="28" ry="24" />
									<ellipse cx="88" cy="48" rx="34" ry="30" />
									<ellipse cx="128" cy="42" rx="32" ry="28" />
									<ellipse cx="168" cy="56" rx="30" ry="26" />
									<ellipse cx="110" cy="68" rx="78" ry="26" />
								</g>
								<ellipse cx="78" cy="42" rx="16" ry="10" fill="rgba(255,255,255,0.4)" />
								<ellipse cx="130" cy="38" rx="12" ry="8" fill="rgba(255,255,255,0.28)" />
							</svg>
						</span>
						<span class="cap-meta mono">{String(journey.length).padStart(2, '0')} stops · 2014 – now</span>
						<span class="cap-title display">Experience</span>
						<span class="cap-sub">Seven roles, two training grounds. Forms plus where I leveled up.</span>
					</a>
					<a class="nimbus-card nimbus-card-b reveal" href="#androids" data-pack="projects">
						<span class="nimbus-ride deco" aria-hidden="true">
							<svg class="nimbus-cloud" viewBox="0 0 220 110" role="img">
								<defs>
									<linearGradient id="nimbusCyan" x1="0" y1="0" x2="0" y2="1">
										<stop offset="0%" stop-color="#d9fffb" />
										<stop offset="40%" stop-color="#6ef0e8" />
										<stop offset="100%" stop-color="#1a9e97" />
									</linearGradient>
								</defs>
								<ellipse cx="110" cy="98" rx="72" ry="7" fill="rgba(0,0,0,0.3)" />
								<g fill="url(#nimbusCyan)" stroke="#0e7a74" stroke-width="2.5" stroke-linejoin="round">
									<ellipse cx="48" cy="62" rx="28" ry="24" />
									<ellipse cx="88" cy="48" rx="34" ry="30" />
									<ellipse cx="128" cy="42" rx="32" ry="28" />
									<ellipse cx="168" cy="56" rx="30" ry="26" />
									<ellipse cx="110" cy="68" rx="78" ry="26" />
								</g>
								<ellipse cx="78" cy="42" rx="16" ry="10" fill="rgba(255,255,255,0.45)" />
								<ellipse cx="130" cy="38" rx="12" ry="8" fill="rgba(255,255,255,0.3)" />
							</svg>
						</span>
						<span class="cap-meta mono">0{androids.length} projects</span>
						<span class="cap-title display">Projects</span>
						<span class="cap-sub">Agents and vision systems that made it to production.</span>
					</a>
				</div>
			</section>

			<!-- EXPERIENCE -->
			<section id="upgrades" class="upgrades">
				<SectionHead
					index="01"
					eyebrow="Where I've worked"
					title="Experience"
					plainTitle="Experience"
					guide="Nine stops on the route — roles as forms, college as training places. Newest first."
				/>
				<ol class="timeline journey">
					{
						journey.map((stop, i) => {
							if (stop.kind === 'work') {
								const u = stop.data;
								return (
									<li class="release reveal" style={`--aura:${u.form.aura}; --d:${i * 0.05}s`}>
										<div class="node" aria-hidden="true">
											<span class="display year">'{u.model}</span>
										</div>
										<div class="stop-body">
											<div class="encounter deco" aria-hidden="true">
												<span class="partner">
													<img class="sprite" src={u.form.img} alt="" width="96" height="120" loading="lazy" />
													<span class="partner-platform"></span>
												</span>
												<span class="partner-tag mono">{u.form.name}!</span>
											</div>
											<details class="release-card panel" open={i === 0}>
												<summary>
													<span class="rel-top mono">
														<span class="model">{u.period}</span>
														<span class="form-tag" style={`--aura:${u.form.aura}`}>
															{u.form.short}
														</span>
														{i === 0 && <span class="live">● CURRENT</span>}
													</span>
													<span class="role">{u.role}</span>
													<span class="org">
														{u.org} · {u.location}
													</span>
													<span class="codename mono">{u.codename}</span>
												</summary>
												<ul class="changelog">
													{u.changelog.map((c) => <li>{c}</li>)}
												</ul>
											</details>
										</div>
									</li>
								);
							}

							const e = stop.data;
							return (
								<li class="release release-train reveal" style={`--aura:${e.place.aura}; --d:${i * 0.05}s`}>
									<div class="node node-train" aria-hidden="true">
										<span class="display year">'{e.model}</span>
									</div>
									<div class="stop-body">
										<div class="encounter deco" aria-hidden="true">
											<span class="partner">
												<img class="sprite" src={e.place.img} alt="" width="96" height="120" loading="lazy" />
												<span class="partner-platform"></span>
											</span>
											<span class="partner-tag mono">Met {e.place.mentor}!</span>
										</div>
										<details class="release-card panel train-card">
											<summary>
												<span class="rel-top mono">
													<span class="model">{e.period}</span>
													<span class="form-tag train-tag" style={`--aura:${e.place.aura}`}>
														{e.place.short}
													</span>
													<span class="train-pill">● TRAINING</span>
												</span>
												<span class="role">{e.degree}</span>
												<span class="org">
													{e.school} · {e.location}
												</span>
												<span class="codename mono">
													<span class="t-theme">{e.place.name} · </span>
													{e.codename}
												</span>
											</summary>
											<ul class="changelog">
												{e.changelog.map((c) => <li>{c}</li>)}
											</ul>
										</details>
									</div>
								</li>
							);
						})
					}
				</ol>
			</section>

			<!-- PROJECTS -->
			<section id="androids" class="androids">
				<SectionHead
					index="02"
					eyebrow="What I've built"
					title="Projects"
					plainTitle="Projects"
					guide="Things that shipped to production."
				/>
				<div class="grid">
					{
						androids.map((a) => (
							<article class="spec panel reveal">
								<span class="spec-no display deco" aria-hidden="true">
									{a.id}
								</span>
								<p class="eyebrow">
									{a.origin}
								</p>
								<h3>{a.name}</h3>
								<p class="mission">{a.mission}</p>
								<ul class="chips">
									{a.specs.map((s) => <li>{s}</li>)}
								</ul>
								<dl class="status mono">
									<div>
										<dt>Guardrails</dt>
										<dd class="on">ON</dd>
									</div>
									<div>
										<dt>Human-in-loop</dt>
										<dd class={a.hitl ? 'on' : 'auto'}>{a.hitl ? 'ON' : 'AUTO'}</dd>
									</div>
								</dl>
							</article>
						))
					}
				</div>
			</section>

			<!-- MODULES -->
			<section id="modules" class="modules">
				<SectionHead
					index="03"
					eyebrow="Installed modules"
					title="Core systems"
					plainTitle="Skills"
					guide="The toolbox. Mostly Python and PyTorch, plus whatever the problem needs."
				/>
				<div class="mod-grid">
					{
						modules.map((m) => (
							<div class="module panel reveal">
								<div class="mod-head">
									<h3>{m.name}</h3>
									<span class="mono count">{m.items.length} loaded</span>
								</div>
								<ul class="chips">
									{m.items.map((s) => <li>{s}</li>)}
								</ul>
							</div>
						))
					}
				</div>
			</section>

			<!-- PROFILE -->
			<section id="profile" class="profile">
				<SectionHead
					index="04"
					eyebrow="Unit profile"
					title="Engineer specification"
					plainTitle="About me"
					guide="The person behind the units."
				/>
				<div class="profile-grid">
					<div class="id-card panel reveal">
						<div class="id-top mono">
							<span class="t-theme">LAB ID · SM-26</span><span class="t-plain">Profile</span>
							<span class="chip-gold deco" aria-hidden="true"></span>
						</div>
						<div class="id-body">
							<img src={profile.photo} alt={profile.name} width="120" height="120" />
							<div>
								<h3>{profile.name}</h3>
								<dl class="fields">
									<div><dt>Role</dt><dd>{profile.currentRole}, {profile.currentOrg}</dd></div>
									<div><dt>Based in</dt><dd>{profile.location}</dd></div>
									<div><dt>Runtime</dt><dd>{profile.years} years</dd></div>
								</dl>
							</div>
						</div>
						<p class="summary">{profile.summary}</p>
						<p class="off mono">
							<span class="t-theme">OFF-DUTY MODE:</span><span class="t-plain">Off the clock:</span>
							{profile.offDuty.join(' · ')}
						</p>
						<a class="more" href="/about">More about me →</a>
					</div>

					<div class="side">
						<div class="panel block reveal">
							<p class="eyebrow"><span class="t-theme">Training data</span><span class="t-plain">Education</span></p>
							<ul class="edu">
								{
									education.map((e) => (
										<li>
											<strong>{e.degree}</strong>
											<span>{e.school}</span>
											<span class="mono when">{e.period}</span>
										</li>
									))
								}
							</ul>
						</div>
						<div class="panel block reveal">
							<p class="eyebrow">
								<span class="t-theme">Certified components · 0{certifications.length}</span>
								<span class="t-plain">Certifications</span>
							</p>
							<ul class="certs">
								{certifications.map((c) => <li>{c}</li>)}
							</ul>
						</div>
					</div>
				</div>
			</section>

			<!-- LOGS -->
			<section id="logs" class="logs">
				<SectionHead index="05" eyebrow="Field logs" title="Lab notes" plainTitle="Recent writing" />
				<div class="log-grid">
					{
						posts.map((post) => (
							<a class="log panel reveal" href={`/blog/${post.slug}/`}>
								{post.data.heroImage && <img src={post.data.heroImage} alt="" loading="lazy" />}
								<span class="mono date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="log-title">{post.data.title}</span>
							</a>
						))
					}
				</div>
				<a class="btn all-logs" href="/blog">
					<span class="t-theme">All field logs →</span><span class="t-plain">All posts →</span>
				</a>
			</section>

			<!-- CONTACT -->
			<section id="contact" class="contact panel reveal">
				<div class="energy deco" aria-hidden="true"></div>
				<p class="eyebrow">06 / Activation</p>
				<h2 class="display">
					<span class="t-theme">Want to build something?</span><span class="t-plain">Get in touch</span>
				</h2>
				<p class="mono cmdline deco">$ activate --unit srikar --mission "your-team"</p>
				<p>
					If you have a workflow that should be an agent, or an agent that keeps breaking, I'd like to hear about it.
				</p>
				<div class="cta">
					<a class="btn btn-primary" href={`mailto:${profile.email}`}>{profile.email}</a>
					<a class="btn" href={profile.linkedin} target="_blank" rel="noopener">LinkedIn</a>
					<a class="btn" href={profile.github} target="_blank" rel="noopener">GitHub</a>
				</div>
			</section>
		</main>
		<SaiyanTransform />
		<Footer />

		<script>
			const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const reveal = new IntersectionObserver(
				(entries) => {
					entries.forEach((e) => {
						if (e.isIntersecting) {
							e.target.classList.add('in');
							reveal.unobserve(e.target);
						}
					});
				},
				{ threshold: 0.12 }
			);
			document.querySelectorAll('.reveal').forEach((el) => reveal.observe(el));

			const count = new IntersectionObserver(
				(entries) => {
					entries.forEach((e) => {
						if (!e.isIntersecting) return;
						const el = e.target as HTMLElement;
						count.unobserve(el);
						const target = Number(el.dataset.count);
						if (reduce || document.documentElement.classList.contains('plain')) return;
						const start = performance.now();
						const tick = (t: number) => {
							const p = Math.min((t - start) / 1200, 1);
							el.textContent = String(Math.round(target * (1 - Math.pow(1 - p, 3))));
							if (p < 1) requestAnimationFrame(tick);
						};
						requestAnimationFrame(tick);
					});
				},
				{ threshold: 0.6 }
			);
			document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => count.observe(el));
		</script>

		<style>
			section {
				margin-bottom: 6rem;
				scroll-margin-top: 90px;
			}

			:global(html.js) .reveal {
				opacity: 0;
				transform: translateY(18px);
				transition: opacity 0.6s ease, transform 0.6s ease;
			}
			:global(html.js) .reveal.in,
			:global(html.plain) .reveal {
				opacity: 1;
				transform: none;
			}
			@media (prefers-reduced-motion: reduce) {
				:global(html.js) .reveal {
					opacity: 1;
					transform: none;
				}
			}

			/* HERO */
			.hero {
				display: grid;
				grid-template-columns: 1.15fr 1fr;
				gap: 3rem;
				align-items: center;
				min-height: calc(100vh - 160px);
				margin-bottom: 3rem;
			}
			.tagline {
				margin: 0.9rem 0 0;
				font-size: 0.95rem;
				color: var(--orange);
			}
			.hero h1 {
				font-size: clamp(2.6rem, 6vw, 4.6rem);
				line-height: 1.02;
				margin: 0.6rem 0 1.2rem;
				text-shadow: 4px 4px 0 rgba(0, 0, 0, 0.6);
			}
			:global(html.plain) .hero h1 {
				text-shadow: none;
				font-size: clamp(2.2rem, 5vw, 3.4rem);
				line-height: 1.1;
			}
			.hl {
				color: var(--orange);
				text-shadow:
					4px 4px 0 rgba(0, 0, 0, 0.6),
					0 0 30px rgba(255, 122, 26, 0.45);
			}
			.lede {
				font-size: 1.1rem;
				color: var(--text);
				max-width: 38rem;
			}
			.lede strong {
				color: var(--heading);
			}
			.cta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.5rem;
			}

			.scan {
				overflow: hidden;
				box-shadow:
					0 0 0 1px rgba(63, 242, 255, 0.08),
					0 30px 80px rgba(0, 0, 0, 0.5),
					var(--glow-cyan);
			}
			.scan-bar {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				padding: 0.6rem 1rem;
				font-size: 0.7rem;
				letter-spacing: 0.14em;
				color: var(--muted);
				border-bottom: 1px solid var(--line);
				background: rgba(63, 242, 255, 0.04);
			}
			.lights {
				display: flex;
				gap: 6px;
			}
			.lights i {
				width: 9px;
				height: 9px;
				border-radius: 50%;
				background: var(--red);
			}
			.lights i:nth-child(2) {
				background: var(--yellow);
			}
			.lights i:nth-child(3) {
				background: var(--green);
			}
			.scan-body {
				display: grid;
				grid-template-columns: auto 1fr;
				gap: 1.25rem;
				padding: 1.25rem;
				align-items: start;
			}
			.portrait {
				position: relative;
				width: 132px;
				height: 132px;
				border-radius: 12px;
				overflow: hidden;
				border: 1px solid var(--line-strong);
			}
			.portrait img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				filter: saturate(0.9) contrast(1.05);
			}
			.reticle {
				position: absolute;
				inset: 10px;
				border: 2px solid transparent;
				background:
					linear-gradient(var(--cyan), var(--cyan)) top left / 16px 2px,
					linear-gradient(var(--cyan), var(--cyan)) top left / 2px 16px,
					linear-gradient(var(--cyan), var(--cyan)) top right / 16px 2px,
					linear-gradient(var(--cyan), var(--cyan)) top right / 2px 16px,
					linear-gradient(var(--cyan), var(--cyan)) bottom left / 16px 2px,
					linear-gradient(var(--cyan), var(--cyan)) bottom left / 2px 16px,
					linear-gradient(var(--cyan), var(--cyan)) bottom right / 16px 2px,
					linear-gradient(var(--cyan), var(--cyan)) bottom right / 2px 16px;
				background-repeat: no-repeat;
			}
			.scanline {
				position: absolute;
				left: 0;
				right: 0;
				height: 40%;
				background: linear-gradient(to bottom, transparent, rgba(63, 242, 255, 0.35), transparent);
				animation: scan 2.6s ease-in-out infinite;
			}
			@keyframes scan {
				0% {
					top: -40%;
				}
				100% {
					top: 100%;
				}
			}
			.diag {
				list-style: none;
				margin: 0;
				padding: 0;
				font-size: 0.78rem;
				line-height: 1.55;
			}
			.diag li {
				display: grid;
				grid-template-columns: 8.5em 1fr;
				gap: 0.5em;
				opacity: 0;
				animation: line 0.35s ease forwards;
				animation-delay: var(--d, 0s);
			}
			:global(html.plain) .diag li,
			:global(html:not(.js)) .diag li {
				opacity: 1;
			}
			@media (prefers-reduced-motion: reduce) {
				.diag li {
					opacity: 1;
				}
			}
			.diag .cmd {
				display: block;
				color: var(--orange);
				margin-bottom: 0.35em;
				animation-delay: 0.1s;
			}
			.diag .k {
				color: var(--muted);
			}
			.diag .v {
				color: var(--heading);
			}
			.diag .ready {
				display: block;
				margin-top: 0.5em;
				color: var(--green);
				font-weight: 700;
			}
			.caret {
				animation: caret 1s steps(1) infinite;
			}
			@keyframes line {
				from {
					opacity: 0;
					transform: translateX(-6px);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}
			@keyframes caret {
				50% {
					opacity: 0;
				}
			}

			/* METRICS */
			.metrics {
				display: grid;
				grid-template-columns: repeat(4, 1fr);
				gap: 1rem;
			}
			.metric {
				padding: 1.25rem;
				position: relative;
				overflow: hidden;
			}
			.metric::after {
				content: '';
				position: absolute;
				left: 0;
				bottom: 0;
				height: 3px;
				width: 100%;
				background: linear-gradient(90deg, var(--orange), var(--yellow));
			}
			.num {
				font-size: 3rem;
				line-height: 1;
				margin: 0 0 0.4rem;
				color: var(--orange);
			}
			.label {
				margin: 0;
				color: var(--heading);
				font-weight: 700;
				line-height: 1.3;
			}
			.note {
				margin: 0.3rem 0 0;
				font-size: 0.72rem;
				color: var(--muted);
			}

			/* FLYING NIMBUS PATHS */
			.nimbus-paths {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1.25rem;
			}
			.nimbus-card {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				padding: 1.5rem 1.75rem 1.75rem;
				border-radius: 28px;
				text-decoration: none;
				color: var(--text);
				background:
					radial-gradient(ellipse at 30% 0%, rgba(255, 210, 63, 0.22), transparent 55%),
					var(--panel);
				border: 1px solid rgba(255, 210, 63, 0.28);
				transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
				overflow: hidden;
			}
			.nimbus-card-b {
				background:
					radial-gradient(ellipse at 30% 0%, rgba(63, 242, 255, 0.18), transparent 55%),
					var(--panel);
				border-color: rgba(63, 242, 255, 0.28);
			}
			.nimbus-card:hover {
				transform: translateY(-6px);
				border-color: rgba(255, 210, 63, 0.55);
				box-shadow: 0 0 28px rgba(255, 210, 63, 0.28);
				color: var(--text);
			}
			.nimbus-card-b:hover {
				border-color: rgba(63, 242, 255, 0.55);
				box-shadow: var(--glow-cyan);
			}
			.nimbus-ride {
				display: block;
				width: min(220px, 100%);
				margin: 0 0 0.6rem;
			}
			.nimbus-cloud {
				width: 100%;
				height: auto;
				display: block;
				filter: drop-shadow(0 10px 14px rgba(0, 0, 0, 0.35));
				animation: nimbus-float 3.2s ease-in-out infinite;
			}
			.nimbus-card:hover .nimbus-cloud {
				animation-duration: 1.6s;
			}
			.nimbus-card-b .nimbus-cloud {
				animation-delay: 0.4s;
			}
			@keyframes nimbus-float {
				0%,
				100% {
					transform: translateY(0);
				}
				50% {
					transform: translateY(-8px);
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.nimbus-cloud {
					animation: none;
				}
			}
			:global(html.plain) .nimbus-card {
				border-radius: 14px;
				border-color: var(--line);
				background: var(--panel);
				box-shadow: none;
			}
			.cap-meta {
				font-size: 0.7rem;
				letter-spacing: 0.14em;
				color: var(--muted);
			}
			.cap-title {
				font-size: 2.2rem;
				line-height: 1;
				color: var(--heading);
			}
			.cap-sub {
				color: var(--muted);
			}

			/* TIMELINE */
			.timeline {
				list-style: none;
				margin: 0;
				padding: 0;
				position: relative;
			}
			.timeline::before {
				content: '';
				position: absolute;
				left: 23px;
				top: 10px;
				bottom: 10px;
				width: 2px;
				background: linear-gradient(var(--orange), var(--cyan) 60%, transparent);
			}
			.release {
				display: grid;
				grid-template-columns: 48px 1fr;
				gap: 1rem;
				margin-bottom: 1.5rem;
				align-items: start;
			}
			.node {
				position: relative;
				width: 48px;
				height: 48px;
				border-radius: 50%;
				display: grid;
				place-items: center;
				background: var(--panel-solid);
				border: 2px solid color-mix(in srgb, var(--aura, var(--cyan)) 70%, #fff 10%);
				color: var(--heading);
				box-shadow: 0 0 14px color-mix(in srgb, var(--aura, var(--cyan)) 40%, transparent);
				z-index: 1;
			}
			.release:first-child .node {
				border-color: var(--aura, var(--orange));
			}
			.node .year {
				font-size: 0.95rem;
				font-weight: 700;
				letter-spacing: 0.02em;
			}
			:global(html.plain) .node {
				border-color: var(--line-strong);
				box-shadow: none;
			}
			.stop-body {
				display: grid;
				grid-template-columns: 110px 1fr;
				gap: 0.75rem 1rem;
				align-items: center;
			}
			.encounter {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.15rem;
				min-height: 132px;
				animation: encounter-in 0.5s ease both;
				animation-delay: var(--d, 0s);
			}
			.partner {
				position: relative;
				width: 100px;
				height: 112px;
				display: block;
			}
			.sprite {
				position: absolute;
				left: 50%;
				bottom: 14px;
				width: auto;
				height: 96px;
				transform: translateX(-50%);
				object-fit: contain;
				object-position: bottom center;
				filter: drop-shadow(0 4px 0 rgba(0, 0, 0, 0.35));
				animation: sprite-bob 2.4s ease-in-out infinite;
				z-index: 1;
			}
			.partner-platform {
				position: absolute;
				left: 50%;
				bottom: 4px;
				width: 72px;
				height: 14px;
				margin-left: -36px;
				border-radius: 50%;
				background: radial-gradient(
					ellipse,
					color-mix(in srgb, var(--aura, var(--cyan)) 55%, transparent),
					transparent 70%
				);
				box-shadow: 0 0 12px color-mix(in srgb, var(--aura, var(--cyan)) 30%, transparent);
			}
			.partner-tag {
				font-size: 0.65rem;
				letter-spacing: 0.06em;
				color: color-mix(in srgb, var(--aura, var(--yellow)) 85%, #fff);
				text-align: center;
				line-height: 1.25;
				max-width: 110px;
			}
			@keyframes sprite-bob {
				0%,
				100% {
					transform: translateX(-50%) translateY(0);
				}
				50% {
					transform: translateX(-50%) translateY(-5px);
				}
			}
			@keyframes encounter-in {
				from {
					opacity: 0;
					transform: translateY(8px);
				}
				to {
					opacity: 1;
					transform: none;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.sprite {
					animation: none;
				}
				.encounter {
					animation: none;
				}
			}
			.release-card {
				padding: 0;
				overflow: hidden;
				min-width: 0;
			}
			.form-tag {
				color: color-mix(in srgb, var(--aura, var(--orange)) 85%, #fff);
				border: 1px solid color-mix(in srgb, var(--aura, var(--orange)) 55%, transparent);
				padding: 0.1em 0.55em;
				border-radius: 999px;
				letter-spacing: 0.1em;
			}
			.train-pill {
				color: var(--green);
			}
			.node-train {
				border-style: dashed;
			}
			.train-card {
				border-style: dashed;
				border-color: color-mix(in srgb, var(--aura, var(--green)) 45%, var(--line));
			}
			.train-card summary:hover {
				background: color-mix(in srgb, var(--aura, var(--green)) 8%, transparent);
			}
			summary {
				display: flex;
				flex-direction: column;
				gap: 0.15rem;
				padding: 1.1rem 1.3rem;
				cursor: pointer;
				list-style: none;
				position: relative;
			}
			summary::-webkit-details-marker {
				display: none;
			}
			summary::after {
				content: '+';
				position: absolute;
				right: 1.2rem;
				top: 1rem;
				font-family: var(--font-mono);
				font-size: 1.3rem;
				color: var(--cyan);
				transition: transform 0.2s;
			}
			details[open] summary::after {
				transform: rotate(45deg);
			}
			summary:hover {
				background: rgba(63, 242, 255, 0.04);
			}
			.rel-top {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem 1rem;
				font-size: 0.72rem;
				letter-spacing: 0.12em;
				color: var(--muted);
			}
			.model {
				color: var(--orange);
				font-weight: 700;
			}
			.live {
				color: var(--green);
			}
			.role {
				font-size: 1.2rem;
				font-weight: 700;
				color: var(--heading);
				padding-right: 2rem;
			}
			.org {
				color: var(--text);
			}
			.codename {
				align-self: flex-start;
				margin-top: 0.35rem;
				font-size: 0.7rem;
				padding: 0.15em 0.6em;
				border-radius: 999px;
				border: 1px solid var(--line-strong);
				color: var(--cyan);
			}
			.changelog {
				list-style: none;
				margin: 0;
				padding: 0.25rem 1.3rem 1.2rem;
				border-top: 1px dashed var(--line);
			}
			.changelog li {
				position: relative;
				padding-left: 1.6rem;
				margin-top: 0.6rem;
				font-size: 0.95rem;
			}
			.changelog li::before {
				content: '+';
				position: absolute;
				left: 0;
				top: 0;
				font-family: var(--font-mono);
				font-weight: 700;
				color: var(--green);
			}

			/* ANDROIDS */
			.grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
			}
			.spec {
				position: relative;
				overflow: hidden;
				padding: 1.4rem;
				display: flex;
				flex-direction: column;
				background:
					linear-gradient(rgba(63, 242, 255, 0.04) 1px, transparent 1px) 0 0 / 100% 18px,
					var(--panel);
				transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
			}
			:global(html.plain) .spec {
				background: var(--panel);
			}
			.spec:hover {
				transform: translateY(-4px);
				border-color: var(--line-strong);
				box-shadow: var(--glow-cyan);
			}
			.spec-no {
				position: absolute;
				right: 0.8rem;
				top: 0.2rem;
				font-size: 3.4rem;
				line-height: 1;
				color: transparent;
				-webkit-text-stroke: 1px rgba(255, 122, 26, 0.4);
			}
			.spec .eyebrow,
			.spec h3 {
				padding-right: 4.5rem;
			}
			.spec h3 {
				font-size: 1.35rem;
				margin: 0.1rem 0 0.5rem;
			}
			.mission {
				font-size: 0.95rem;
				color: var(--text);
				flex: 1;
			}
			.chips {
				list-style: none;
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 0 0 1rem;
				padding: 0;
			}
			.chips li {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				padding: 0.25em 0.65em;
				border-radius: 6px;
				background: rgba(63, 242, 255, 0.07);
				border: 1px solid var(--line);
				color: var(--text);
			}
			.status {
				display: flex;
				gap: 1.25rem;
				margin: 0;
				padding-top: 0.8rem;
				border-top: 1px dashed var(--line);
				font-size: 0.7rem;
				letter-spacing: 0.08em;
			}
			.status div {
				display: flex;
				gap: 0.4rem;
			}
			.status dt {
				color: var(--muted);
				text-transform: uppercase;
			}
			.status dd {
				margin: 0;
				font-weight: 700;
			}
			.on {
				color: var(--green);
			}
			.auto {
				color: var(--cyan);
			}

			/* MODULES */
			.mod-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.25rem;
			}
			.module {
				padding: 1.3rem;
			}
			.module:first-child {
				grid-column: 1 / -1;
				border-color: rgba(255, 122, 26, 0.45);
			}
			.mod-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1rem;
				margin-bottom: 0.8rem;
			}
			.mod-head h3 {
				font-size: 1.15rem;
				margin: 0;
			}
			.count {
				font-size: 0.7rem;
				color: var(--green);
				white-space: nowrap;
			}
			.module .chips {
				margin: 0;
			}

			/* PROFILE */
			.profile-grid {
				display: grid;
				grid-template-columns: 1.3fr 1fr;
				gap: 1.25rem;
			}
			.id-card {
				padding: 0;
				overflow: hidden;
				border-color: rgba(255, 122, 26, 0.45);
			}
			.id-top {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0.7rem 1.3rem;
				font-size: 0.72rem;
				letter-spacing: 0.15em;
				color: #140800;
				font-weight: 700;
				background: linear-gradient(90deg, var(--orange), var(--yellow));
			}
			:global(html.plain) .id-top {
				color: #fff;
			}
			.chip-gold {
				width: 30px;
				height: 22px;
				border-radius: 4px;
				background: linear-gradient(135deg, #f6e27a, #b8902c);
				box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
			}
			.id-body {
				display: flex;
				gap: 1.25rem;
				padding: 1.3rem 1.3rem 0;
				align-items: center;
			}
			.id-body img {
				width: 110px;
				height: 110px;
				object-fit: cover;
				border-radius: 12px;
				border: 2px solid var(--line-strong);
			}
			.id-body h3 {
				margin-bottom: 0.4rem;
			}
			.fields {
				margin: 0;
				font-size: 0.9rem;
			}
			.fields div {
				display: flex;
				gap: 0.6rem;
			}
			.fields dt {
				min-width: 5.5em;
				color: var(--muted);
				font-family: var(--font-mono);
				font-size: 0.75rem;
				text-transform: uppercase;
				padding-top: 0.2em;
			}
			.fields dd {
				margin: 0;
				color: var(--heading);
			}
			.summary {
				padding: 1rem 1.3rem 0;
				font-size: 0.95rem;
			}
			.off {
				margin: 0 1.3rem;
				padding: 0.7rem 0;
				border-top: 1px dashed var(--line);
				font-size: 0.75rem;
				color: var(--text);
			}
			.off span {
				color: var(--green);
				margin-right: 0.5em;
			}
			.more {
				display: inline-block;
				margin: 0 1.3rem 1.3rem;
			}
			.side {
				display: flex;
				flex-direction: column;
				gap: 1.25rem;
			}
			.block {
				padding: 1.3rem;
			}
			.edu,
			.certs {
				list-style: none;
				margin: 0.5rem 0 0;
				padding: 0;
			}
			.edu li {
				display: flex;
				flex-direction: column;
				margin-bottom: 0.8rem;
			}
			.edu strong {
				color: var(--heading);
			}
			.when {
				font-size: 0.72rem;
				color: var(--muted);
			}
			.certs li {
				position: relative;
				padding-left: 1.6rem;
				margin-bottom: 0.45rem;
				font-size: 0.92rem;
			}
			.certs li::before {
				content: '✓';
				position: absolute;
				left: 0;
				color: var(--green);
				font-weight: 700;
			}

			/* LOGS */
			.log-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 1.25rem;
				margin-bottom: 1.5rem;
			}
			.log {
				display: flex;
				flex-direction: column;
				overflow: hidden;
				text-decoration: none;
				color: var(--text);
				transition: transform 0.2s ease, box-shadow 0.2s ease;
			}
			.log:hover {
				transform: translateY(-4px);
				box-shadow: var(--glow-cyan);
				color: var(--text);
			}
			.log img {
				aspect-ratio: 16 / 9;
				object-fit: cover;
				width: 100%;
				border-radius: 0;
				border-bottom: 1px solid var(--line);
			}
			.log .date {
				padding: 0.9rem 1.1rem 0;
				font-size: 0.72rem;
				color: var(--muted);
			}
			.log-title {
				padding: 0.2rem 1.1rem 1.1rem;
				font-weight: 700;
				color: var(--heading);
			}

			/* CONTACT */
			.contact {
				position: relative;
				overflow: hidden;
				padding: 3rem 2rem;
				text-align: center;
				border-color: rgba(255, 122, 26, 0.5);
			}
			.contact h2 {
				font-size: clamp(2rem, 5vw, 3.2rem);
				margin: 0.3rem 0 0.8rem;
			}
			.contact p {
				max-width: 36rem;
				margin-inline: auto;
			}
			.contact .cta {
				justify-content: center;
			}
			.cmdline {
				color: var(--green);
				font-size: 0.85rem;
			}
			.energy {
				position: absolute;
				inset: -40%;
				background: conic-gradient(
					from 0deg,
					transparent,
					rgba(255, 122, 26, 0.12),
					transparent 30%,
					rgba(63, 242, 255, 0.1),
					transparent 60%
				);
				animation: spin 14s linear infinite;
				pointer-events: none;
			}
			.contact > :not(.energy) {
				position: relative;
			}
			@keyframes spin {
				to {
					transform: rotate(360deg);
				}
			}

			@media (max-width: 960px) {
				.hero,
				.profile-grid {
					grid-template-columns: 1fr;
				}
				.hero {
					min-height: auto;
					gap: 2rem;
				}
				.metrics {
					grid-template-columns: repeat(2, 1fr);
				}
				.grid,
				.log-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.stop-body {
					grid-template-columns: 88px 1fr;
				}
				.partner {
					width: 84px;
					height: 96px;
				}
				.sprite {
					height: 80px;
				}
			}
			@media (max-width: 640px) {
				section {
					margin-bottom: 4rem;
				}
				.nimbus-paths,
				.grid,
				.log-grid,
				.mod-grid {
					grid-template-columns: 1fr;
				}
				.scan-body {
					grid-template-columns: 1fr;
				}
